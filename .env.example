# dikodingbot configuration. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; never commit real tokens.

# --- Required ------------------------------------------------------------

# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:AA-your-telegram-bot-token-here

# Numeric Telegram user ID of the single allowed operator. Every message from
# any other user is rejected. If unset/0 the bot rejects EVERYONE (fail-safe).
# Find yours by messaging @userinfobot.
ALLOWED_USER_ID=0

# --- Optional (shown with their defaults) --------------------------------

# Path to the Claude Code CLI binary. Default: "claude" (found on PATH).
CLAUDE_BIN=claude

# Base workspace directory. /projects lists its subfolders; /switch and uploads
# are confined to it. "~" is expanded. Default: ~/workspace
BASE_DIR=~/workspace

# Seconds before a hung claude call is killed. 0 (or unset) = NO TIMEOUT, so
# long repository reviews run to completion. Set to e.g. 300 to cap runs.
# /cancel always works regardless of this.
CLAUDE_TIMEOUT=0

# Max size (bytes) for uploaded documents. Default: 26214400 (25 MiB).
MAX_UPLOAD_BYTES=26214400

# Buffer cap (bytes) for one line of Claude's stream-json output.
# Default: 10485760 (10 MiB). One line holds a whole tool result, so a web
# fetch or large file read can be megabytes. Below this, the run fails with
# "Separator is not found, and chunk exceed the limit". Raise it if you see
# "dropped an oversized event" in the output.
# CLAUDE_STREAM_LIMIT=10485760

# --- Telegram rate limiting ----------------------------------------------
# Telegram allows about 20 messages per minute per chat, and editing the live
# preview counts against the same quota as sending the answer. These defaults
# leave enough budget for the final message; lower LIVE_EDIT_INTERVAL only if
# you are willing to trade delivery for a smoother preview.

# Seconds between live-preview edits. Default 4.0 (about 15 edits/minute).
# LIVE_EDIT_INTERVAL=4.0

# Retries for a message Telegram rejected with 429. Default 3.
# SEND_MAX_RETRIES=3

# Longest single retry wait (seconds) before giving up and sending the output
# as a file instead. Default 60.
# SEND_MAX_RETRY_WAIT=60

# Pause (seconds) between chunks of a long reply. Default 0.4.
# SEND_CHUNK_DELAY=0.4

# Where the per-workspace session map is persisted.
# Default: sessions.json next to bot.py
# SESSION_FILE=/absolute/path/to/sessions.json

# Log level for stderr output. Default: INFO. Set to DEBUG for very chatty logs.
# LOG_LEVEL=INFO

# Where Claude Code keeps its own config/session transcripts. The bot reads
# this to check whether a recorded session UUID can still be resumed.
# Default: ~/.claude
# CLAUDE_CONFIG_DIR=~/.claude

# --- Claude API / router (passed through to the CLI) ---------------------
# Only needed if you route Claude Code through a custom endpoint. Leave the
# whole block unset to use Claude Code's own login/credentials.
# ANTHROPIC_BASE_URL=https://your-router.example/
# ANTHROPIC_API_KEY=sk-your-token-here
# ANTHROPIC_MODEL=claude-sonnet-5
# CLAUDE_CODE_USE_AUTH_TOKEN=true

# --- /model command ------------------------------------------------------
# In-process cache TTL (seconds) for the /v1/models list. Default 60.
# MODEL_CACHE_TTL=60

# Where the /model selection is persisted. Default: active_model.txt next to bot.py
# MODEL_FILE=/absolute/path/to/active_model.txt

# Claude permission mode. Runtime-switchable via /perm; this is only the
# starting value. Default: dontAsk (autonomous, blocks destructive actions).
# Use bypassPermissions for the old full-power behavior.
# PERMISSION_MODE=dontAsk

# Where the /perm selection is persisted. Default: active_permission.txt next to bot.py
# PERMISSION_FILE=/absolute/path/to/active_permission.txt
